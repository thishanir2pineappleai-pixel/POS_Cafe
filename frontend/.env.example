# Frontend (Vite). Copy to .env (git ignores it) only to override the default.
# Where the API Gateway is; the frontend only ever talks to the Gateway, never to an individual service.
# The default is the local Gateway; the Gateway's CORS_ORIGIN must include the address this app is served from.
# VITE_API_BASE_URL=http://127.0.0.1:4100/api/v1
