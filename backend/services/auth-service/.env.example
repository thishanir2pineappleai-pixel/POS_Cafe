# Auth Service (development). Copy to .env (git ignores it) only to override the defaults below.
# Variables shared by every service (JWT_SECRET, INTERNAL_SERVICE_KEY, HOST, NODE_ENV) belong in backend/.env.

# Port of this service. Only the API Gateway should call it; the frontend never does.
AUTH_SERVICE_PORT=4001
# HOST must stay a loopback address; the service refuses to start otherwise.
HOST=127.0.0.1

# Signs and verifies access tokens and keys the one-time-code hashes. At least 32 random characters, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# EVERY service must use the same value. If it is missing in development a temporary key is used and sign-ins end on restart.
# REQUIRED when NODE_ENV=production.
JWT_SECRET=

# Protects /internal/* (the session check other services call). At least 32 random characters, the same value in every
# service. REQUIRED when NODE_ENV=production. Without it in development, other services cannot confirm sessions (503).
INTERNAL_SERVICE_KEY=

# How verification codes and access keys leave the service:
#   none        (default) nothing is sent
#   dev-outbox  local testing only: messages (with the raw codes) are kept in memory and shown at GET /api/v1/dev/outbox.
#               Refused when NODE_ENV=production.
#   smtp        EMAIL (signup code, access key, password-reset code) is sent through the SMTP server below.
#               SMS is NOT sent in any mode: no SMS provider is configured.
MESSAGE_DELIVERY=none

# ---- Real email through SMTP (only read when MESSAGE_DELIVERY=smtp; the service refuses to start if one is missing or invalid) ----
# This file is the best place for the password: only the Auth Service reads it. It is ignored by Git. Never put a real value here
# in the .example file.
# Gmail example (port 587 with STARTTLS):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# true = encrypted from the first byte (port 465); false = STARTTLS upgrade (port 587). Default: true only for port 465.
# STARTTLS is REQUIRED: when the server does not offer it nothing is sent in plain text. The only exception is a server on
# this machine (localhost / 127.0.0.1), for a local mail catcher such as MailHog.
# SMTP_SECURE=false
# Both or neither. For Gmail: your address and an APP PASSWORD (Google Account > Security > 2-Step Verification > App passwords).
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# The sender address (a plain address). Gmail only sends as the signed-in address or one of its verified aliases.
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=PAI POS
# Whole-send limit in milliseconds (default 10000). Keep it below the Gateway's UPSTREAM_TIMEOUT_MS (15000), or the Gateway
# answers 504 before the mail server does.
# SMTP_TIMEOUT_MS=10000

# LOCAL DEVELOPMENT ONLY. There is no SMS provider, so the signup's phone code can never arrive and the signup would stop there.
# true = the phone step is skipped, the number is saved but recorded as NOT verified, the API answers phoneVerification: "skipped"
# and the screen says so. The EMAIL code is still required. The service REFUSES TO START with this set to true when
# NODE_ENV=production. Leave it unset (or false) anywhere real.
# DEV_SKIP_PHONE_VERIFICATION=true

# Where the Settings Service listens. It owns shop profiles: signup activation creates the first shop there and
# GET /auth/me lists an account's shops from it. If it cannot be reached those calls fail with 503.
SETTINGS_SERVICE_URL=http://127.0.0.1:4002
# How long to wait for the Settings Service, in milliseconds.
SETTINGS_TIMEOUT_MS=3000

# Where uploaded files are kept. Default: this service's own uploads/ folder (git ignores it). Point it at a volume or
# another folder if needed; the service creates its subfolders there on the first upload.
# UPLOADS_DIR=

# ---- Database (MySQL through Prisma) ----
# memory (default): data is kept in the process and LOST on restart; needs no database.
# prisma: data is stored in MySQL (pos_auth_db). REQUIRED when NODE_ENV=production.
REPOSITORY_DRIVER=memory
# Only needed with REPOSITORY_DRIVER=prisma. Use the restricted account created by backend/database/create-databases.sql.
# Put the real value in backend/.env or this service's .env (git ignores them), never in this file.
# AUTH_DATABASE_URL=mysql://pos_auth_app:YOUR_PASSWORD@127.0.0.1:3306/pos_auth_db
# Optional: an account allowed to CREATE/ALTER tables, used ONLY by the Prisma CLI (db:migrate:*). The running service uses the
# restricted AUTH_DATABASE_URL above. Without it the CLI falls back to AUTH_DATABASE_URL.
# AUTH_MIGRATION_DATABASE_URL=mysql://pos_auth_migrate:YOUR_PASSWORD@127.0.0.1:3306/pos_auth_db
# Only `prisma migrate dev` needs this (a scratch database it uses to check migrations).
# AUTH_SHADOW_DATABASE_URL=mysql://pos_auth_app:YOUR_PASSWORD@127.0.0.1:3306/pos_auth_db_shadow
# Only the repository and persistence tests need this. The database name MUST end in _test: the tests empty its tables.
# AUTH_TEST_DATABASE_URL=mysql://pos_auth_app:YOUR_PASSWORD@127.0.0.1:3306/pos_auth_db_test
