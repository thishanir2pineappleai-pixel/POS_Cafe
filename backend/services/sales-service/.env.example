# Sales Service (development). Copy to .env (git ignores it) only to override the defaults below.
# Variables shared by every service (JWT_SECRET, INTERNAL_SERVICE_KEY, HOST, NODE_ENV, REPOSITORY_DRIVER, the database URLs)
# belong in backend/.env.

# Port of this service. PENDING APPROVAL: 4005 is the port proposed in MIGRATION_PLAN_SALES_REPORTING.md (question 5).
# Only the API Gateway and other services should call it; the frontend never does.
SALES_SERVICE_PORT=4005
# HOST must stay a loopback address; the service refuses to start otherwise.
HOST=127.0.0.1

# Must equal the value the Auth Service uses (at least 32 characters). REQUIRED when NODE_ENV=production.
JWT_SECRET=
# Protects the service-to-service calls and is sent to the Auth Service to confirm sessions. Same value in every service.
INTERNAL_SERVICE_KEY=

# Where the Auth Service listens. Every request is confirmed there; if it cannot be reached, requests fail with 503.
AUTH_SERVICE_URL=http://127.0.0.1:4001
# How long to wait for the Auth Service, in milliseconds.
AUTH_TIMEOUT_MS=3000
# Where the Settings Service listens (it owns shop profiles; Sales asks which shops belong to the signed-in account).
SETTINGS_SERVICE_URL=http://127.0.0.1:4002
SETTINGS_TIMEOUT_MS=3000
# Where the Menu Service listens (it owns products and discount definitions; Sales asks it for prices and discounts).
MENU_SERVICE_URL=http://127.0.0.1:4004
MENU_TIMEOUT_MS=3000

# ---- Database (MySQL through Prisma) ----
# memory (default): data is kept in the process and LOST on restart; needs no database.
# prisma: data is stored in MySQL (pos_sales_db). REQUIRED when NODE_ENV=production.
REPOSITORY_DRIVER=memory
# Only needed with REPOSITORY_DRIVER=prisma. Use the restricted account created by backend/database/create-databases.sql.
# Put the real value in backend/.env or this service's .env (git ignores them), never in this file.
# SALES_DATABASE_URL=mysql://pos_sales_app:YOUR_PASSWORD@127.0.0.1:3306/pos_sales_db
# Optional: an account allowed to CREATE/ALTER tables, used ONLY by the Prisma CLI (db:migrate:*). The running service uses the
# restricted SALES_DATABASE_URL above. Without it the CLI falls back to SALES_DATABASE_URL.
# SALES_MIGRATION_DATABASE_URL=mysql://pos_sales_migrate:YOUR_PASSWORD@127.0.0.1:3306/pos_sales_db
# Only `prisma migrate dev` needs this (a scratch database it uses to check migrations).
# SALES_SHADOW_DATABASE_URL=mysql://pos_sales_app:YOUR_PASSWORD@127.0.0.1:3306/pos_sales_db_shadow
# Only the repository and persistence tests need this. The database name MUST end in _test: the tests empty its tables.
# SALES_TEST_DATABASE_URL=mysql://pos_sales_app:YOUR_PASSWORD@127.0.0.1:3306/pos_sales_db_test
