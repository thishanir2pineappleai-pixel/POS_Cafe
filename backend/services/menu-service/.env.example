# Menu Service (development). Copy to .env (git ignores it) only to override the defaults below.
# Variables shared by every service (JWT_SECRET, INTERNAL_SERVICE_KEY, HOST, NODE_ENV) belong in backend/.env.

# Port of this service. Only the API Gateway and other services should call it; the frontend never does.
MENU_SERVICE_PORT=4004
# HOST must stay a loopback address; the service refuses to start otherwise.
HOST=127.0.0.1

# Must equal the value the Auth Service uses (at least 32 characters). REQUIRED when NODE_ENV=production.
JWT_SECRET=
# Protects /internal/* and is sent to the Auth Service to confirm sessions. Same value in every service.
INTERNAL_SERVICE_KEY=

# true (recommended, and what the frontend expects: it always sends its token): every Menu API route needs a signed-in user
# (any account); the Auth Service confirms the session, and requests fail with 503 while it cannot be reached.
# false (the built-in default when this variable is missing, the behaviour of the old backend): every Menu API route is OPEN.
# Menu data is NOT scoped to an account or a shop either way (products have none yet): every signed-in account sees the same menu.
# REQUIRED to be true in production: start-up is refused otherwise.
MENU_REQUIRE_AUTH=true
# Where the Auth Service listens, and how long to wait for it, in milliseconds (used only when MENU_REQUIRE_AUTH=true).
AUTH_SERVICE_URL=http://127.0.0.1:4001
AUTH_TIMEOUT_MS=3000

# Where uploaded files are kept. Default: this service's own uploads/ folder (git ignores it). Point it at a volume or
# another folder if needed; the service creates its subfolders there on the first upload.
# UPLOADS_DIR=

# ---- Database (MySQL through Prisma) ----
# memory (default): data is kept in the process and LOST on restart; needs no database.
# prisma: data is stored in MySQL (pos_menu_db). REQUIRED when NODE_ENV=production.
REPOSITORY_DRIVER=memory
# Only needed with REPOSITORY_DRIVER=prisma. Use the restricted account created by backend/database/create-databases.sql.
# Put the real value in backend/.env or this service's .env (git ignores them), never in this file.
# MENU_DATABASE_URL=mysql://pos_menu_app:YOUR_PASSWORD@127.0.0.1:3306/pos_menu_db
# Optional: an account allowed to CREATE/ALTER tables, used ONLY by the Prisma CLI (db:migrate:*). The running service uses the
# restricted MENU_DATABASE_URL above. Without it the CLI falls back to MENU_DATABASE_URL.
# MENU_MIGRATION_DATABASE_URL=mysql://pos_menu_migrate:YOUR_PASSWORD@127.0.0.1:3306/pos_menu_db
# Only `prisma migrate dev` needs this (a scratch database it uses to check migrations).
# MENU_SHADOW_DATABASE_URL=mysql://pos_menu_app:YOUR_PASSWORD@127.0.0.1:3306/pos_menu_db_shadow
# Only the repository and persistence tests need this. The database name MUST end in _test: the tests empty its tables.
# MENU_TEST_DATABASE_URL=mysql://pos_menu_app:YOUR_PASSWORD@127.0.0.1:3306/pos_menu_db_test
