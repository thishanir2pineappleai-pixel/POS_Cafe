# Shared settings of the gateway and every service in backend/ (development). Copy to backend/.env (git ignores it).
# Each service reads its own services/<name>/.env first, then this file. Never put real secrets in this example file.

# HOST must stay a loopback address; every service and the gateway refuse to start otherwise.
HOST=127.0.0.1
# Comma-separated list of allowed browser origins (the local Vite dev server). Used by the gateway.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MUST be the same for all services (services verify tokens locally). At least 32 random characters, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If it is missing in development each process invents its own key, so tokens from the Auth Service are rejected by the others.
# REQUIRED when NODE_ENV=production.
JWT_SECRET=
# MUST be the same for all services. Protects the service-to-service endpoints (/internal/*) and is sent with every
# internal call. At least 32 random characters. Without it, services cannot confirm sessions (503). REQUIRED in production.
INTERNAL_SERVICE_KEY=

# How verification codes and access keys leave the Auth Service:
#   none        (default) nothing is sent
#   dev-outbox  local testing only: messages (with the raw codes) are kept in memory and shown at GET /api/v1/dev/outbox.
#               Refused when NODE_ENV=production.
#   smtp        EMAIL (signup code, access key, password-reset code) is sent through the SMTP server below.
#               SMS is NOT sent in any mode: no SMS provider is configured.
MESSAGE_DELIVERY=none

# ---- Real email through SMTP (only read when MESSAGE_DELIVERY=smtp) ----
# Put these in backend/services/auth-service/.env instead of here if you can: the SMTP password is then visible to the Auth
# Service only (this file is read by every service). Never put a real password in this example file.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# true = encrypted from the first byte (port 465); false = STARTTLS upgrade (port 587). Default: true only for port 465.
# SMTP_SECURE=false
# Gmail: your address, and an APP PASSWORD (Google Account > Security > 2-Step Verification > App passwords), never the account password.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# The sender address. Gmail only sends as the signed-in address (or one of its verified aliases).
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=PAI POS
# Whole-send limit in milliseconds; keep it below the Gateway's UPSTREAM_TIMEOUT_MS (15000). Default 10000.
# SMTP_TIMEOUT_MS=10000

# LOCAL DEVELOPMENT ONLY. There is no SMS provider, so the phone code of the signup can never arrive. true = the signup skips the
# phone step, the number is saved as NOT verified and the screen says so. The email code is still required. Refused at start-up
# when NODE_ENV=production.
# DEV_SKIP_PHONE_VERIFICATION=true

# ---- Storage: MySQL through Prisma ----
# memory (default): data is lost when a service restarts. prisma: data is stored in MySQL. NODE_ENV=production requires prisma.
# A service started with prisma and a missing/invalid URL refuses to start; it never falls back to memory.
REPOSITORY_DRIVER=memory

# ONE MySQL server, one logical database per service that owns data (created by backend/database/create-databases.sql, run by
# you as a MySQL administrator). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE. Replace CHANGE_ME with your own password in
# your private backend/.env only, never in this file. Percent-encode special characters in the password (@ -> %40, : -> %3A,
# / -> %2F, # -> %23, % -> %25).
AUTH_DATABASE_URL=mysql://pos_auth_app:CHANGE_ME@127.0.0.1:3306/pos_auth_db
SETTINGS_DATABASE_URL=mysql://pos_settings_app:CHANGE_ME@127.0.0.1:3306/pos_settings_db
STAFF_DATABASE_URL=mysql://pos_staff_app:CHANGE_ME@127.0.0.1:3306/pos_staff_db
MENU_DATABASE_URL=mysql://pos_menu_app:CHANGE_ME@127.0.0.1:3306/pos_menu_db
SALES_DATABASE_URL=mysql://pos_sales_app:CHANGE_ME@127.0.0.1:3306/pos_sales_db

# OPTIONAL migration accounts. The running services use the *_DATABASE_URL values above (least privilege: SELECT/INSERT/UPDATE/DELETE
# only). The Prisma CLI (db:migrate:deploy, db:migrate:status, db:migrate:dev) uses <SVC>_MIGRATION_DATABASE_URL when it is set, so
# the account that may CREATE/ALTER tables is never the one the service runs with. Keep these in your private shell or backend/.env.
# AUTH_MIGRATION_DATABASE_URL=mysql://pos_auth_migrate:CHANGE_ME@127.0.0.1:3306/pos_auth_db
# SETTINGS_MIGRATION_DATABASE_URL=mysql://pos_settings_migrate:CHANGE_ME@127.0.0.1:3306/pos_settings_db
# STAFF_MIGRATION_DATABASE_URL=mysql://pos_staff_migrate:CHANGE_ME@127.0.0.1:3306/pos_staff_db
# MENU_MIGRATION_DATABASE_URL=mysql://pos_menu_migrate:CHANGE_ME@127.0.0.1:3306/pos_menu_db
# SALES_MIGRATION_DATABASE_URL=mysql://pos_sales_migrate:CHANGE_ME@127.0.0.1:3306/pos_sales_db

# Only `prisma migrate dev` (creating a NEW migration during development) needs these scratch databases.
# `prisma migrate deploy` does not, and neither does running the services.
# AUTH_SHADOW_DATABASE_URL=mysql://pos_auth_app:CHANGE_ME@127.0.0.1:3306/pos_auth_db_shadow
# SETTINGS_SHADOW_DATABASE_URL=mysql://pos_settings_app:CHANGE_ME@127.0.0.1:3306/pos_settings_db_shadow
# STAFF_SHADOW_DATABASE_URL=mysql://pos_staff_app:CHANGE_ME@127.0.0.1:3306/pos_staff_db_shadow
# MENU_SHADOW_DATABASE_URL=mysql://pos_menu_app:CHANGE_ME@127.0.0.1:3306/pos_menu_db_shadow
# SALES_SHADOW_DATABASE_URL=mysql://pos_sales_app:CHANGE_ME@127.0.0.1:3306/pos_sales_db_shadow

# Repository tests against MySQL. Keep these OUT of backend/.env (set them in one terminal only): those tests EMPTY the
# tables of the database they point at, and refuse any database whose name does not end in _test.
# AUTH_TEST_DATABASE_URL=mysql://pos_auth_app:CHANGE_ME@127.0.0.1:3306/pos_auth_db_test
# SETTINGS_TEST_DATABASE_URL=mysql://pos_settings_app:CHANGE_ME@127.0.0.1:3306/pos_settings_db_test
# STAFF_TEST_DATABASE_URL=mysql://pos_staff_app:CHANGE_ME@127.0.0.1:3306/pos_staff_db_test
# MENU_TEST_DATABASE_URL=mysql://pos_menu_app:CHANGE_ME@127.0.0.1:3306/pos_menu_db_test
# SALES_TEST_DATABASE_URL=mysql://pos_sales_app:CHANGE_ME@127.0.0.1:3306/pos_sales_db_test
